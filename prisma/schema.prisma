generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  GUEST
}

enum GenerationKind {
  TEXT
  IMAGE
  VIDEO
}

enum GenerationStatus {
  DRAFT
  QUEUED
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  BLOCKED
  EXPIRED
}

enum MediaAssetKind {
  REFERENCE
  RESULT
  WB_RESULT
}

enum ProviderEventType {
  REQUEST
  RESPONSE
  STATUS
  ERROR
}

enum InvitationStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}
enum AccessPeriodStatus {
  ACTIVE
  EXPIRED
  REVOKED
}
enum CreditReservationStatus {
  HELD
  RELEASED
  CHARGED
}
enum CreditLedgerKind {
  GRANT
  ADJUSTMENT
  DEBIT
  CHARGE
  REFUND
}
enum TariffStatus {
  ACTIVE
  RETIRED
}
enum MarginEventLevel {
  WARNING
  BLOCKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  displayName  String?  @map("display_name")
  isBlocked    Boolean  @default(false) @map("is_blocked")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  generationJobs GenerationJob[]
  mediaAssets    MediaAsset[]
  auditEvents    AuditLog[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  accessPeriods AccessPeriod[]
  creditLedger CreditLedger[]
  creditReservations CreditReservation[]
  freeTextAllowance FreeTextAllowance?
  projects Project[]
  chats Chat[]
  messages ChatMessage[]
  sessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  recoveryCodes AdminRecoveryCode[]

  @@map("users")
}

model AdminRecoveryCode {
  id String @id
  userId String @map("user_id")
  codeHash String @unique @map("code_hash")
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, usedAt])
  @@map("admin_recovery_codes")
}

model AuthSession {
  id String @id
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id String @id
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuthRateLimit {
  key String @id
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  attempts Int @default(0)
  @@map("auth_rate_limits")
}

model Invitation {
  id String @id
  email String
  displayName String? @map("display_name")
  tokenHash String @unique @map("token_hash")
  isEmergency Boolean @default(false) @map("is_emergency")
  isGuest Boolean @default(false) @map("is_guest")
  guestCredits Decimal? @map("guest_credits") @db.Decimal(18, 4)
  status InvitationStatus @default(PENDING)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdByUserId String @map("created_by_user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  creator User @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  @@index([email, status])
  @@index([expiresAt])
  @@map("invitations")
}

model AccessPeriod {
  id String @id
  userId String @map("user_id")
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)
  status AccessPeriodStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  freeTextAllowance FreeTextAllowance?
  @@index([userId, startsAt, endsAt])
  @@map("access_periods")
}

model FreeTextAllowance {
  id String @id
  userId String @unique @map("user_id")
  accessPeriodId String @unique @map("access_period_id")
  totalLimit Int @default(250) @map("total_limit")
  usedCount Int @default(0) @map("used_count")
  dailyLimit Int @default(20) @map("daily_limit")
  dayStartsAt DateTime @map("day_starts_at") @db.Date
  dayUsedCount Int @default(0) @map("day_used_count")
  maxExternalBudget Decimal @default(20) @db.Decimal(18, 6) @map("max_external_budget")
  reservedExternalBudget Decimal @default(0) @db.Decimal(18, 6) @map("reserved_external_budget")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessPeriod AccessPeriod @relation(fields: [accessPeriodId], references: [id], onDelete: Restrict)
  @@map("free_text_allowances")
}

model CreditLedger {
  id String @id
  userId String @map("user_id")
  amount Decimal @db.Decimal(18, 4)
  kind CreditLedgerKind
  reason String
  generationJobId String? @map("generation_job_id")
  actorUserId String? @map("actor_user_id")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([generationJobId])
  @@map("credit_ledger")
}

model CreditReservation {
  id String @id
  userId String @map("user_id")
  generationJobId String @unique @map("generation_job_id")
  amount Decimal @db.Decimal(18, 4)
  status CreditReservationStatus @default(HELD)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)
  reason String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, status])
  @@map("credit_reservations")
}

model TariffVersion {
  id String @id
  modelConfigId String @map("model_config_id")
  parameterKey Json @map("parameter_key")
  parameterHash String @map("parameter_hash")
  version Int
  status TariffStatus @default(ACTIVE)
  creditPrice Decimal @db.Decimal(18, 4) @map("credit_price")
  currency String @default("CREDIT")
  maxExternalCost Decimal @db.Decimal(18, 6) @map("max_external_cost")
  externalCurrency String @default("RUB") @map("external_currency")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)
  @@unique([modelConfigId, parameterHash, version])
  @@index([modelConfigId, parameterHash, status])
  @@map("tariff_versions")
}

model Project {
  id String @id
  userId String @map("user_id")
  name String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  chats Chat[]
  @@index([userId, updatedAt])
  @@map("projects")
}

model Chat {
  id String @id
  userId String @map("user_id")
  projectId String? @map("project_id")
  title String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  @@index([userId, updatedAt])
  @@map("chats")
}

model ChatMessage {
  id String @id
  chatId String @map("chat_id")
  userId String @map("user_id")
  role String
  content String
  generationJobId String? @map("generation_job_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([chatId, createdAt])
  @@map("chat_messages")
}

model ServiceSetting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("service_settings")
}

model MarginEvent {
  id String @id
  generationJobId String @map("generation_job_id")
  level MarginEventLevel
  actualCost Decimal? @db.Decimal(18, 6) @map("actual_cost")
  ceiling Decimal @db.Decimal(18, 6)
  details Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([level, createdAt])
  @@index([generationJobId])
  @@map("margin_events")
}

model ModelConfig {
  id                     String          @id
  displayName            String          @map("display_name")
  technicalModelId       String          @unique @map("technical_model_id")
  generationKind         GenerationKind  @map("generation_kind")
  isActive               Boolean         @default(true) @map("is_active")
  allowedParameters      Json            @default("{}") @map("allowed_parameters")
  providerConfiguration  Json            @default("{}") @map("provider_configuration")
  longRunningAfterSeconds Int?           @map("long_running_after_seconds")
  createdAt              DateTime        @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt              DateTime        @updatedAt @db.Timestamptz(6) @map("updated_at")
  generationJobs         GenerationJob[]

  @@map("model_configs")
}

model GenerationJob {
  id                    String           @id
  userId                String?          @map("user_id")
  modelConfigId         String           @map("model_config_id")
  generationKind        GenerationKind   @map("generation_kind")
  status                GenerationStatus @default(DRAFT)
  prompt                String
  parameters            Json             @default("{}")
  correlationId         String           @unique @map("correlation_id")
  idempotencyKey        String           @unique @map("idempotency_key")
  providerName          String?          @map("provider_name")
  providerJobId         String?          @map("provider_job_id")
  attemptCount          Int              @default(0) @map("attempt_count")
  maxAttempts           Int              @default(3) @map("max_attempts")
  availableAt           DateTime         @default(now()) @db.Timestamptz(6) @map("available_at")
  lastAttemptAt         DateTime?        @db.Timestamptz(6) @map("last_attempt_at")
  nextRetryAt           DateTime?        @db.Timestamptz(6) @map("next_retry_at")
  leaseToken            String?          @map("lease_token")
  leasedAt              DateTime?        @db.Timestamptz(6) @map("leased_at")
  leaseExpiresAt        DateTime?        @db.Timestamptz(6) @map("lease_expires_at")
  workerInstanceId      String?          @map("worker_instance_id")
  submittedAt           DateTime?        @db.Timestamptz(6) @map("submitted_at")
  processingStartedAt   DateTime?        @db.Timestamptz(6) @map("processing_started_at")
  completedAt           DateTime?        @db.Timestamptz(6) @map("completed_at")
  failedAt              DateTime?        @db.Timestamptz(6) @map("failed_at")
  lastErrorCode         String?          @map("last_error_code")
  lastErrorMessage      String?          @map("last_error_message")
  lastErrorDetails      Json?            @map("last_error_details")
  actualCost            Decimal?         @db.Decimal(18, 6) @map("actual_cost")
  actualCostCurrency    String?          @map("actual_cost_currency")
  actualCostDetails     Json?            @map("actual_cost_details")
  tariffVersionId       String?          @map("tariff_version_id")
  tariffSnapshot        Json?            @map("tariff_snapshot")
  creditPrice           Decimal?         @db.Decimal(18, 4) @map("credit_price")
  creditCurrency        String?          @map("credit_currency")
  createdAt             DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime         @updatedAt @db.Timestamptz(6) @map("updated_at")
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  modelConfig           ModelConfig      @relation(fields: [modelConfigId], references: [id], onDelete: Restrict)
  mediaAssets           MediaAsset[]
  providerEvents        ProviderEvent[]

  @@index([status, updatedAt])
  @@index([userId, createdAt])
  @@index([tariffVersionId])
  @@map("generation_jobs")
}

model MediaAsset {
  id              String         @id
  userId          String?        @map("user_id")
  generationJobId String?        @map("generation_job_id")
  kind            MediaAssetKind
  storageKey      String         @unique @map("storage_key")
  originalFilename String?       @map("original_filename")
  mimeType        String         @map("mime_type")
  byteSize        BigInt         @map("byte_size")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  expiresAt       DateTime?      @db.Timestamptz(6) @map("expires_at")
  deletedAt       DateTime?      @db.Timestamptz(6) @map("deleted_at")
  user            User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  generationJob   GenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("media_assets")
}

model ProviderEvent {
  id              String            @id
  generationJobId String            @map("generation_job_id")
  eventType       ProviderEventType @map("event_type")
  providerName    String?           @map("provider_name")
  httpStatus      Int?              @map("http_status")
  correlationId   String            @map("correlation_id")
  payload         Json              @default("{}")
  createdAt       DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  generationJob   GenerationJob     @relation(fields: [generationJobId], references: [id], onDelete: Restrict)

  @@index([generationJobId, createdAt])
  @@map("provider_events")
}

model AuditLog {
  id            String    @id
  actorUserId   String?   @map("actor_user_id")
  action        String
  targetType    String    @map("target_type")
  targetId      String?   @map("target_id")
  correlationId String?   @map("correlation_id")
  details       Json      @default("{}")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  actorUser     User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model WorkerHeartbeat {
  instanceId String   @id @map("instance_id")
  startedAt  DateTime @default(now()) @db.Timestamptz(6) @map("started_at")
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6) @map("last_seen_at")
  metadata   Json     @default("{}")

  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}
