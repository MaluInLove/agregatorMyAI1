# PostgreSQL database created once during local setup.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/ai_aggregator?schema=public"

# Used only by `npm.cmd run test:integration`. Create this separate database
# yourself; its name must end in _test and it must never match DATABASE_URL.
TEST_DATABASE_URL=""

# Used only on the first successful bootstrap. Do not commit the real values.
INITIAL_ADMIN_EMAIL="admin@example.local"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD"

# Reserved for the server-only Polza adapter in task 3. Never use NEXT_PUBLIC_ for secrets.
POLZA_API_KEY=""

LOCAL_STORAGE_PATH="var/storage"

# Object storage is local by default. For a VPS set OBJECT_STORAGE_DRIVER=s3
# and fill the following server-only values (MinIO supports this interface).
OBJECT_STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="ai-aggregator"
# MinIO normally requires path-style URLs. Set false only for a provider that
# explicitly requires virtual-hosted bucket URLs.
S3_FORCE_PATH_STYLE="true"

# Optional absolute path to ffmpeg.exe when it is not available in PATH.
FFMPEG_PATH=""

# Public base URL. Required to generate password-reset links in production.
APP_URL="http://127.0.0.1:3000"

# Postmark is used only for self-service password reset messages. Keep empty until
# the sender address/domain is verified in Postmark. Never expose this token to browsers.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM="support@example.com"
