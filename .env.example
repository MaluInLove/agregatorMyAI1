# PostgreSQL database created once during local setup.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/ai_aggregator?schema=public"

# Used only on the first successful bootstrap. Do not commit the real values.
INITIAL_ADMIN_EMAIL="admin@example.local"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD"

# Reserved for the server-only Polza adapter in task 3. Never use NEXT_PUBLIC_ for secrets.
POLZA_API_KEY=""

LOCAL_STORAGE_PATH="var/storage"
