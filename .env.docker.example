# Copy to .env.docker, set unique values, and do not commit the copy.
# Start with: docker compose --env-file .env.docker up --build -d
POSTGRES_DB="ai_aggregator"
POSTGRES_USER="ai_aggregator"
POSTGRES_PASSWORD="CHANGE_TO_A_LONG_UNIQUE_DATABASE_PASSWORD"
APP_PORT="3000"

INITIAL_ADMIN_EMAIL="admin@example.local"
INITIAL_ADMIN_PASSWORD="CHANGE_TO_A_LONG_UNIQUE_ADMIN_PASSWORD"
POLZA_API_KEY=""
APP_URL="https://aggregator.example.com"

# Local Docker storage is the default. For S3/MinIO set driver to s3 and fill all values.
OBJECT_STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="ai-aggregator"
S3_FORCE_PATH_STYLE="true"

POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM="support@example.com"
